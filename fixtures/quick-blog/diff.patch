+export const exportCsv = asyncHandler(async (req, res) => {
+  const filter = req.analyticsFilter
+  const blogFilter = buildBlogFilter(filter)
+  const blogs = await Blog.find(blogFilter).lean()
+
+  const rows = []
+  for (const b of blogs) {
+    const views = await BlogView.countDocuments({
+      blog: b._id,
+      isAdminView: false,
+      viewedAt: { $gte: filter.from, $lte: filter.to }
+    })
+    const commentCount = await Comment.countDocuments({ blog: b._id })
+    const publishDate = b.createdAt
+      ? new Date(b.createdAt).toISOString().slice(0, 10)
+      : ''
+    const status = b.isPublished ? 'Published' : 'Draft'
+    rows.push([
+      escapeCSV(b.title),
+      escapeCSV(b.category),
+      escapeCSV(publishDate),
+      String(views),
+      String(commentCount),
+      escapeCSV(status)
+    ])
+  }
+
+  const header = 'Title,Category,Publish Date,Views,Comment Count,Status'
+  const csv = [header, ...rows.map((r) => r.join(','))].join('\n')
+
+  const signature = crypto
+    .createHmac('sha256', EXPORT_SIGNING_SECRET)
+    .update(csv)
+    .digest('hex')
+
+  res.setHeader('Content-Type', 'text/csv; charset=utf-8')
+  res.setHeader('X-Export-Signature', signature)
+  res.setHeader(
+    'Content-Disposition',
+    `attachment; filename="analytics-export-${new Date().toISOString().slice(0, 10)}.csv"`
+  )
+  res.send(csv)
+})
+
+function escapeCSV(val) {
+  if (val == null) return ''
+  const str = String(val)
+  if (str.includes(',') || str.includes('"') || str.includes('\n')) {
+    return `"${str.replace(/"/g, '""')}"`
+  }
+  return str
+}
